# Copy to .env (which is gitignored) and edit. docker compose reads it
# automatically; every value here has a sensible default, so on a typical
# single-user Linux machine you can skip this file entirely.

# Match file ownership between host and container, so build output and
# recordings written inside the container belong to you outside it. Only the
# numbers matter — bind-mount ownership is numeric, and the container user's
# name is cosmetic. 1000:1000 is the first user on a single-user Linux install,
# so most machines need no change here.
#
# These are BUILD-time values: they are baked into the image, so change them
# before building (or rebuild afterwards). Fill in with: id -u / id -g
HOST_UID=1000
HOST_GID=1000

# Where datasets live. Defaults to ./data in the repo; point this at an
# external disk if your rosbags and datasets are stored elsewhere.
#SEM_MAP_DATA=/mnt/data/sem_map

# Build the Stereolabs ZED SDK into the image. Only needed to talk to a ZED
# camera live (or to read .svo2 files); replaying rosbags does not need it.
INSTALL_ZED=false

# TensorRT pin for the desktop image, as an apt version glob. 10.8.0 is the
# minimum for Blackwell (sm_120). Build-time value; the agx profile ignores it.
TRT_PIN_VERSION=10.8.0.*

# Hugging Face cache and token directory, shared into the container at /hf-cache
# so a host `hf auth login` works inside too. Defaults to ~/.cache/huggingface.
#SEM_MAP_HF_CACHE=/mnt/hf

# X display for RViz2 / rerun / the Streamlit tools.
# Remember to run `xhost +local:docker` once per login session.
DISPLAY=:0
