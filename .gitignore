# These are all directories at the repository root. The leading slash matters:
# without it, "artifacts/" would also match scripts/artifacts/ and silently drop
# the model download and upload scripts from git.

# Model artifacts: fetched with scripts/artifacts/download.sh, never committed
/artifacts/

# Scratch space for internal documents that must not reach a public repo
/untracked/

# Datasets: downloaded, see docs/GRANDTOUR.md. The directory itself is kept in
# git so docker compose's ./data bind mount does not create it as root.
/data/*
!/data/.gitkeep
*.mcap
*.db3
*.bag
*.svo2

# Colcon output
/install/
/log/

# Recorded bags, training runs and pipeline outputs
/recordings/
/outputs/
scripts/sem_map/training/runs/
scripts/sem_map/training/eval_results/

# Optional JAFAR clone (see JAFAR_ROOT in the README)
/external/

.vscode/
.idea/
.bash_history
